{
  "source": {
    "file": "lib/demos/course_enrollment_page.dart",
    "pageClass": "CourseEnrollmentPage",
    "cubitClass": "CourseEnrollmentCubit",
    "stateClass": "CourseEnrollmentState",
    "fileCubit": "lib/cubit/course_enrollment_cubit.dart",
    "fileState": "lib/cubit/course_enrollment_state.dart"
