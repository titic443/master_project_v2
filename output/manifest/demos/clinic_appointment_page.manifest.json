{
  "source": {
    "file": "lib/demos/clinic_appointment_page.dart",
    "pageClass": "ClinicAppointmentPage",
    "cubitClass": "ClinicAppointmentCubit",
    "stateClass": "ClinicAppointmentState",
    "fileCubit": "lib/cubit/clinic_appointment_cubit.dart",
    "fileState": "lib/cubit/clinic_appointment_state.dart"
  },
  "widgets": [
    {
      "widgetType": "AlertDialog",
      "key": "appt_10_expected_fail"
    },
    {
      "widgetType": "Radio<String>",
      "key": "appt_05_type_radio_opd",
      "meta": {
        "valueExpr": "'OPD'",
        "groupValueBinding": "state.appointmentType",
        "validatorRules": [
          {
            "condition": "state.appointmentType == null",
            "message": "กรุณาเลือกประเภทการนัด"
          }
        ]
      }
    },
    {
      "widgetType": "AlertDialog",
      "key": "appt_10_expected_success"
    },
    {
      "widgetType": "Radio<String>",
      "key": "appt_05_type_radio_tele",
      "meta": {
        "valueExpr": "'Telemedicine'",
        "groupValueBinding": "state.appointmentType",
        "validatorRules": [
          {
            "condition": "state.appointmentType == null",
            "message": "กรุณาเลือกประเภทการนัด"
          }
        ]
      }
    },
    {
      "widgetType": "TextFormField",
      "key": "appt_01_patient_name_textfield",
      "meta": {
        "validatorRules": [
          {
            "condition": "v == null || v.trim().isEmpty",
            "message": "กรุณากรอกชื่อ-นามสกุล"
          },
          {
            "condition": "!RegExp(r'^[฀-๿a-zA-Z\\s]+$').hasMatch(name)",
            "message": "ใช้ได้เฉพาะตัวอักษรไทยหรืออังกฤษ"
          },
          {
            "condition": "name.split(RegExp(r'\\s+')).length < 2",
            "message": "กรุณากรอกทั้งชื่อและนามสกุล"
          },
          {
            "condition": "!RegExp(r'^[฀-๿a-zA-Z\\s]+$').hasMatch(value)",
            "message": "\\s+"
          }
        ]
      }
    },
    {
      "widgetType": "TextFormField",
      "key": "appt_02_id_card_textfield",
      "meta": {
        "keyboardType": "number",
        "inputFormatters": [
          {
            "type": "digitsOnly"
          },
          {
            "type": "lengthLimit",
            "max": 13
          }
        ],
        "validatorRules": [
          {
            "condition": "v == null || v.trim().isEmpty",
            "message": "กรุณากรอกเลขบัตรประชาชน"
          },
          {
            "condition": "id.length != 13",
            "message": "ต้องมี 13 หลัก"
          },
          {
            "condition": "id[0] == '0'",
            "message": "เลขบัตรไม่ถูกต้อง"
          },
          {
            "condition": "(11 - sum % 11) % 10 != int.parse(id[12])",
            "message": "เลขบัตรประชาชนไม่ถูกต้อง"
          }
        ]
      }
    },
    {
      "widgetType": "TextFormField",
      "key": "appt_03_phone_textfield",
      "meta": {
        "keyboardType": "phone",
        "inputFormatters": [
          {
            "type": "digitsOnly"
          },
          {
            "type": "lengthLimit",
            "max": 10
          }
        ],
        "validatorRules": [
          {
            "condition": "v == null || v.trim().isEmpty",
            "message": "กรุณากรอกเบอร์โทรศัพท์"
          },
          {
            "condition": "!RegExp(r'^0\\d{8,9}$').hasMatch(v.trim())",
            "message": "เบอร์โทรไม่ถูกต้อง (ต้องขึ้นต้นด้วย 0 และมี 9-10 หลัก)"
          }
        ]
      }
    },
    {
      "widgetType": "DropdownButtonFormField<String>",
      "key": "appt_04_department_dropdown",
      "meta": {
        "validatorRules": [
          {
            "condition": "v == null",
            "message": "กรุณาเลือกแผนก"
          }
        ],
        "options": [
          {
            "value": "internal_medicine",
            "text": "อายุรกรรม"
          },
          {
            "value": "surgery",
            "text": "ศัลยกรรม"
          },
          {
            "value": "pediatrics",
            "text": "กุมารเวชศาสตร์"
          },
          {
            "value": "obstetrics",
            "text": "สูติ-นรีเวช"
          },
          {
            "value": "ophthalmology",
            "text": "จักษุวิทยา"
          },
          {
            "value": "ent",
            "text": "หู คอ จมูก"
          },
          {
            "value": "orthopedics",
            "text": "กระดูกและข้อ"
          }
        ]
      }
    },
    {
      "widgetType": "TextFormField",
      "key": "appt_06_date_textfield",
      "meta": {
        "validatorRules": [
          {
            "condition": "v == null || v.trim().isEmpty",
            "message": "กรุณาเลือกวันที่นัดหมาย"
          },
          {
            "condition": "state.appointmentDate != null",
            "message": "ไม่สามารถนัดหมายวันที่ผ่านมาแล้ว"
          }
        ]
      },
      "onTap": "_selectDate",
      "pickerMetadata": {
        "type": "DatePicker",
        "firstDate": "DateTime(2000)",
        "lastDate": "DateTime(2031)",
        "initialDate": "now.add(const Duration(days: 1))"
      }
    },
    {
      "widgetType": "TextFormField",
      "key": "appt_07_time_textfield",
      "meta": {
        "validatorRules": [
          {
            "condition": "v == null || v.trim().isEmpty",
            "message": "กรุณาเลือกช่วงเวลา"
          },
          {
            "condition": "state.appointmentTime != null",
            "message": "เวลาเปิดให้บริการ 08:00–20:00 น."
          }
        ]
      },
      "onTap": "_selectTime",
      "pickerMetadata": {
        "type": "TimePicker",
        "initialTime": "const TimeOfDay(hour: 16, minute: 0)"
      }
    },
    {
      "widgetType": "Switch",
      "key": "appt_08_insurance_switch",
      "meta": {
        "valueBinding": "state.hasInsurance"
      }
    },
    {
      "widgetType": "TextFormField",
      "key": "appt_09_note_textfield"
    },
    {
      "widgetType": "ElevatedButton",
      "key": "appt_10_confirm_button"
    }
  ]
}
